# Port for the API + WebSocket server
PORT=4000

# Comma-separated list of web origins allowed to call this server
WEB_ORIGIN=http://localhost:3000

# --- LLM (any OpenAI-compatible chat completions endpoint) ---
# Leave LLM_API_KEY empty to run in mock mode (canned replies, no cost).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional cap on reply length, sent as max_tokens when set
LLM_MAX_TOKENS=

# --- Supabase (optional) ---
# Leave both empty to run locally with a JSON file store and no sign-in.
# Supabase dashboard > Project Settings > API. The service role key is secret: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Where the local JSON store lives when Supabase is not configured
DATA_FILE=./data/parlor.json

# Number of reverse proxies in front of the server (e.g. 1 on Render), so rate limits use the real client IP
TRUST_PROXY=
