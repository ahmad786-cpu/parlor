# Where the Parlor server runs
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Supabase (optional) ---
# Leave empty to run without sign-in. Must match the server: if the server has
# Supabase keys, fill these in too. Supabase dashboard > Project Settings > API:
# the project URL and the anon / publishable key (safe to expose; never the service role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
