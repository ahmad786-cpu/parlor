# Copy to .env.local for local development. On Vercel, add the same names under
# Project Settings > Environment Variables.

# --- LLM (any OpenAI-compatible chat completions endpoint) ---
# Leave LLM_API_KEY empty to use mock replies (no cost).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional cap on reply length, sent as max_tokens when set
LLM_MAX_TOKENS=

# --- Supabase (optional locally, required on Vercel) ---
# Leave empty to run locally with a JSON file store and no sign-in.
# Supabase dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key: safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service role / secret key: server only, never prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
